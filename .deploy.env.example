# Copy to .deploy.env to override deployment defaults. Never put server or
# application secrets in this file; production secrets stay in remote .env.
DEPLOY_HOST=8.221.106.221
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/play_video/ivapp
DEPLOY_PROJECT=ivapp
DEPLOY_SERVICE=api
DEPLOY_WORKER_SERVICE=worker
DEPLOY_CDN_WORKER_SERVICE=cdn-worker
DEPLOY_DATABASE_SERVICE=mysql
DEPLOY_RELEASE_ROOT=/opt/play_video/releases/ivapp
DEPLOY_BACKUP_ROOT=/opt/play_video/backups/ivapp
DEPLOY_HEALTH_URL=http://127.0.0.1:8100/health
DEPLOY_HEALTH_RETRIES=20
DEPLOY_HEALTH_INTERVAL=2
