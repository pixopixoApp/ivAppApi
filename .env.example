PUBLISH_KEY=change-me
CURSOR_SECRET=change-me-too
SERVER_VER=1.2
LOG_LEVEL=INFO

# Dedicated MySQL for ivapp (do not reuse credentials from another service)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=ivapp

# Host ports — ivapp uses 810x
API_PORT=8100
PHPMYADMIN_PORT=8101
# The deployed 4-vCPU host is validated with three API worker processes.
API_WORKERS=3

# Published mp4 files (compose: ./volumes → /volumes)
MEDIA_ROOT=/volumes/media

# Shared content-addressed video cache. The identical host directory must be
# mounted into ivadmin at /data/media-cache.
MEDIA_CACHE_ENABLED=true
MEDIA_CACHE_ROOT=/data/media-cache
MEDIA_CACHE_HOST_PATH=/opt/play_video/shared/media-cache
MEDIA_CACHE_MIN_FREE_BYTES=21474836480
CREATOR_LOCAL_UPLOAD_ENABLED=true
CREATOR_LOCAL_UPLOAD_CHUNK_BYTES=8388608
# Keep true during the app upgrade window; disable after forced-update adoption.
CREATOR_LEGACY_OSS_UPLOAD_ENABLED=true

# Canonical media storage. These values may be copied from the archived service;
# legacy MOTIONCUE_ALIYUN_OSS_* names are also accepted. Never reuse its object
# prefixes. Production must use mode=oss.
MEDIA_STORAGE_MODE=oss
MEDIA_READ_FALLBACK_LOCAL=true
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET=your-existing-bucket
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=https://video.pixopixo.cn
# Read compatibility only. New writes and every public API response use the
# canonical CDN origin above. Signed/private URLs are never rewritten.
PUBLIC_MEDIA_LEGACY_ORIGINS=https://pixopixo-us.oss-us-east-1.aliyuncs.com,https://api.pixopixo.cn
OSS_ROOT_PREFIX=ivapp-media/v1
PRIVATE_MEDIA_CDN_BASE_URL=
PRIVATE_MEDIA_CDN_AUTH_KEY=
PRIVATE_MEDIA_CDN_AUTH_UID=0
# Must exactly match the Type-A URL signing TTL configured on this CDN domain.
PRIVATE_MEDIA_CDN_TTL_SECONDS=900
OSS_CONNECT_TIMEOUT_SECONDS=10
OSS_UPLOAD_TTL_SECONDS=600
OSS_PRIVATE_GET_TTL_SECONDS=300
OSS_MAX_CONCURRENCY=16

# Exact-file CDN prefetch/refresh outbox. Attach a least-privilege RAM role to
# the ECS instance; do not copy an AccessKey into CDN worker configuration.
CDN_CACHE_ENABLED=true
CDN_PREFETCH_ON_PUBLISH=true
CDN_DOMAIN=video.pixopixo.cn
CDN_API_REGION=cn-hangzhou
CDN_WORKER_POLL_SECONDS=2
CDN_PROVIDER_POLL_SECONDS=10
CDN_WORKER_BATCH_SIZE=50
CDN_WORKER_MAX_ATTEMPTS=6
CDN_WORKER_LEASE_SECONDS=300
ALIBABA_CLOUD_ECS_METADATA=
ALIBABA_CLOUD_IMDSV1_DISABLED=true
# Optional alternative to an ECS role: an explicitly configured RAM key.
# A dedicated least-privilege CDN key is preferred; an existing runtime RAM
# principal is also supported when operations intentionally grants CDN access.
ALIYUN_CDN_ACCESS_KEY_ID=
ALIYUN_CDN_ACCESS_KEY_SECRET=

# Email auth — 阿里企业邮箱（465 SSL；SMTP_HOST 置空则只打日志不发信）
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=your-account@example.com
SMTP_TLS=false
SMTP_SSL=true
CODE_TTL_SECONDS=600
TOKEN_TTL_DAYS=30
SEND_CODE_INTERVAL_SECONDS=60
# App 删号：验证码通过后 scheduled_delete_at = now + N 天（立刻 enabled=false）
ACCOUNT_DELETION_BUFFER_DAYS=30

# Google Sign-In（允许 Android / iOS 各自 OAuth Client ID；保留单数兼容存量部署）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_TIMEOUT_SECONDS=5

# Redis（Feed 曝光去重）
REDIS_URL=redis://redis:6379/0

# Creator coordination — ivapp calls only ivadmin's private API. Use the same
# random CREATOR_INTERNAL_KEY in ivadmin; ivcore/model/Dify secrets stay there.
IVADMIN_BASE_URL=http://host.docker.internal:8000
CREATOR_INTERNAL_KEY=
CREATOR_IVADMIN_TIMEOUT_SECONDS=30
CREATOR_WORKER_POLL_SECONDS=2
CREATOR_VIDEO_MAX_BYTES=125829120
CREATOR_VIDEO_MAX_DURATION_SECONDS=30
PUBLIC_SHARE_BASE_URL=https://api.pixopixo.cn

# 经过审核的不可变 HTML 内容入口（仅 HTTPS origin，多个用逗号分隔）
HTML_TRUSTED_ORIGINS=https://video.pixopixo.cn,https://api.pixopixo.cn,https://pixopixo-us.oss-us-east-1.aliyuncs.com
HTML_PUBLIC_BASE_URL=https://video.pixopixo.cn/ivapp-media/v1/public/html
HTML_PUBLISH_PROBE_TIMEOUT_SECONDS=5
HTML_IMPORT_MAX_ZIP_BYTES=536870912
HTML_IMPORT_MAX_UNPACKED_BYTES=2147483648
HTML_IMPORT_MAX_FILES=1000
HTML_IMPORT_REQUIRE_PLAYWRIGHT=true
HTML_IMPORT_SPOOL_ROOT=/data/html-imports
HTML_IMPORT_PROGRESS_TIMEOUT_SECONDS=10
# Must be the same absolute host directory configured for ivadmin.
HTML_IMPORT_SPOOL_HOST_PATH=/opt/play_video/shared/html-imports

# 本地 HTML 发布工具使用（不应写入服务器镜像；生产凭据请放本机密钥环境）
PIXO_HTML_PUBLIC_BASE_URL=https://video.pixopixo.cn/ivapp-media/v1/public/html
PIXO_BACKEND_URL=https://api.example.com
# PIXO_PUBLISH_KEY 与服务端 PUBLISH_KEY 相同；HTML 工具不再接触 OSS AccessKey。
